# Copie para .env e preencha. O .env NÃO vai para o Git (senha do banco).
# Use os mesmos valores de broker, discovery e banco do docker-compose do Robô Educacional.

# Broker MQTT
MQTT_HOST=
MQTT_PORT=

# Define os tópicos spacexlab/AAS/<ASSET_ID>/command e .../state
ASSET_ID=dobot_cr3

# Identificador da AAS no aas_core (24 caracteres hexadecimais, um por AAS).
# Gerado para o CR3; o Robô Educacional usa outro valor.
AAS_IDENTIFICATION=6aea791368084c990e465ed9

# Serviço de discovery e banco (MongoDB) do laboratório
HOST_DISCOVERY=192.168.100.21
DATABASE_HOST=192.168.100.21
DATABASE_PORT=27019
DATABASE_USER=shell-manager-user
DATABASE_PASS=
